<div class="flex items-center justify-center w-full">
  <div class="w-full max-w-md">
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-8">
      <div class="mb-8 text-center">
        <h1 class="text-3xl font-bold tracking-tight text-gray-900">
          Sign Up
        </h1>
        <p class="mt-2 text-sm text-gray-500">
          Create your account to get started.
        </p>
      </div>

      <%= form_with model: @user, url: users_path, class: "space-y-5" do |form| %>
        <% if form.object.errors.any? %>
          <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
            <span class="font-medium">Error:</span>
            <%= form.object.errors.full_messages.first %>
          </div>
        <% end %>

        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
          <div>
            <%= form.label :first_name, class: "block text-sm font-medium text-gray-700 mb-1.5" %>
            <%= form.text_field :first_name,
              required: true,
              autofocus: true,
              autocomplete: "given-name",
              class: "block w-full rounded-lg border border-gray-300 bg-white px-3.5 py-2.5 text-sm text-gray-900 shadow-sm outline-none transition placeholder:text-gray-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20" %>
          </div>

          <div>
            <%= form.label :last_name, class: "block text-sm font-medium text-gray-700 mb-1.5" %>
            <%= form.text_field :last_name,
              required: true,
              autocomplete: "family-name",
              class: "block w-full rounded-lg border border-gray-300 bg-white px-3.5 py-2.5 text-sm text-gray-900 shadow-sm outline-none transition placeholder:text-gray-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20" %>
          </div>
        </div>

        <div>
          <%= form.label :email_address, class: "block text-sm font-medium text-gray-700 mb-1.5" %>
          <%= form.email_field :email_address,
            required: true,
            autocomplete: "email",
            class: "block w-full rounded-lg border border-gray-300 bg-white px-3.5 py-2.5 text-sm text-gray-900 shadow-sm outline-none transition placeholder:text-gray-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20" %>
        </div>

        <div>
          <%= form.label :password, class: "block text-sm font-medium text-gray-700 mb-1.5" %>
          <%= form.password_field :password,
            required: true,
            autocomplete: "new-password",
            class: "block w-full rounded-lg border border-gray-300 bg-white px-3.5 py-2.5 text-sm text-gray-900 shadow-sm outline-none transition placeholder:text-gray-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20" %>
        </div>

        <div>
          <%= form.label :password_confirmation, class: "block text-sm font-medium text-gray-700 mb-1.5" %>
          <%= form.password_field :password_confirmation,
            required: true,
            autocomplete: "new-password",
            class: "block w-full rounded-lg border border-gray-300 bg-white px-3.5 py-2.5 text-sm text-gray-900 shadow-sm outline-none transition placeholder:text-gray-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20" %>
        </div>

        <div class="pt-2">
          <%= form.submit "Sign up",
            class: "w-full cursor-pointer rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 active:bg-indigo-700" %>
        </div>
      <% end %>

      <div class="mt-6 text-center text-sm text-gray-500">
        Already have an account?
        <%= link_to "Sign in",
          new_session_path,
          class: "font-medium text-indigo-600 hover:text-indigo-500 hover:underline" %>
      </div>
    </div>
  </div>
</div>
